{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wrbtv-site-premium",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wrbtv.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.wrbtv.com.br",
      "custom_domain": true
    }
  ]
}
